# ------------------------
# Core
# ------------------------
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/knowledge_base
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_USER_EMAIL=demo@knowledge-base.local
LOG_LEVEL=INFO
ENVIRONMENT=development

# ------------------------
# Auth / JWT
# ------------------------
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------
# OpenAI (required)
# ------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSIONS=1536

# ------------------------
# External search (required for external resource endpoint)
# ------------------------
SEARCH_PROVIDER=serper
SEARCH_API_KEY=
SEARCH_BASE_URL=https://google.serper.dev/search

# ------------------------
# Retrieval/chunking tuning
# ------------------------
RETRIEVAL_TOP_K=5
MAX_NOTE_CHUNK_CHARS=900

# ------------------------
# Frontend
# ------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
